{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A-Eye",
  "version": "0.1.0",
  "identifier": "dev.aeye.desktop",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "A-Eye — Visual companion",
      "width": 640,
      "height": 740,
      "minWidth": 420,
      "minHeight": 560
    }],
    "security": {
      "csp": "default-src 'none'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "externalBin": ["binaries/aeye-mcp"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "skip" } }
  }
}
