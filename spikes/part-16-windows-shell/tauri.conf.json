{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A-Eye Spike 16",
  "version": "0.1.0",
  "identifier": "dev.aeye.spike16",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "A-Eye Spike 16",
        "width": 560,
        "height": 320,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "skip" }
    }
  }
}
